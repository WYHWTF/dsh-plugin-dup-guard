{
  "name": "dsh-plugin-dup-guard",
  "version": "0.1.1",
  "description": "拦掉重复整读文件和重复抓取同一 URL，省下最贵的输入 token。DSH-Android 优先，纯 JS，无依赖。",
  "type": "module",
  "main": "index.js",
  "exports": {
    "./index.js": "./index.js",
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README-zh.md",
    "LICENSE",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tokens",
    "cache"
  ],
  "license": "MIT",
  "author": "WYHWTF",
  "repository": {
    "type": "git",
    "url": "https://github.com/WYHWTF/dsh-plugin-dup-guard.git"
  },
  "homepage": "https://github.com/WYHWTF/dsh-plugin-dup-guard#readme"
}
